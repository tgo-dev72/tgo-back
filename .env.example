DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# During a controlled key rotation, keep previous keys comma-separated until
# all outstanding signed links and sessions have expired.
DJANGO_SECRET_KEY_FALLBACKS=
# Keep false in shared/production environments. Override to true only in a
# developer's ignored .env file.
IS_DEBUG=False
ALLOWED_HOSTS=api.tijarago.com,
CORS_ALLOWED_ORIGINS=https://dash.tijarago.com,https://www.tijarago.com,https://admin.tijarago.com,
# With IS_DEBUG=True, localhost and private-LAN browser hosts on ports
# 5173-5199 are accepted dynamically. Do not list changing local IPs here.
# Named platform apps. Storefront subdomains are trusted automatically from
# STOREFRONT_BASE_DOMAIN; do not add every generated store manually.
CSRF_TRUSTED_ORIGINS=https://dash.tijarago.com,https://www.tijarago.com,https://admin.tijarago.com,
# Customer-facing unsubscribe confirmation page. Its server-side website
# function also proxies RFC one-click requests without exposing the API origin.
UNSUBSCRIBE_BASE_URL=https://www.tijarago.com/unsubscribe
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Tests default to isolated in-memory SQLite even when DATABASE_URL points to
# shared data. Set this only when intentionally exercising another test engine.
TEST_DATABASE_URL=sqlite:///:memory:

# ── storefront_factory (fill in when deploying) ───────────────────────────────
# DESIGN_STOCK_PATH=/home/zennache/Desktop/design-stock
DESIGN_STOCK_REPO=EnnacherZ/design-stock
# Pin a committed, pushed design-stock revision whose manifest contains the five
# current themes (basic, beauty, fashion, electronics, nexa). The catalog and bundles
# both come from this revision; a local uncommitted manifest is not deployed.
STOREFRONT_RELEASE_REVISION=
GITHUB_TOKEN=
# Optional read-only source token; falls back to GITHUB_TOKEN.
STOREFRONT_SOURCE_TOKEN=
# New requests only. Leave empty for legacy delivery until the canary passes.
# Initialize the private target with a README on the branch below; no root npm workspace.
# Example: your-owner/storefront-deployments
STOREFRONT_DEPLOYMENT_REPO=
STOREFRONT_DEPLOYMENT_BRANCH=main
# Contents read/write on the target repo only. No source-write fallback.
STOREFRONT_DEPLOYMENT_TOKEN=
# false routes only NEW/unpinned requests back to legacy. Retain target repo
# and token above for retries/updates/deletion of already-pinned stores.
STOREFRONT_NEW_REPO_ENABLED=true
# Use local only with IS_DEBUG=True and the local SQLite/API server. The
# storefront runs from design-stock; no GitHub, Vercel, or Cloudflare calls.
STOREFRONT_DEPLOYMENT_MODE=cloud
# Optional domain-free delivery at https://<slug>.vercel.app. Existing domains
# are preserved. Add the exact store origins to CORS/CSRF allowed origins.
# Set VITE_STOREFRONT_BASE_DOMAIN=vercel.app in the showroom environment too.
STOREFRONT_USE_VERCEL_DOMAIN=false
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
# Operator migration previews only; use the specific project's automation
# bypass secret if its preview deployments are protected. Never a VITE_ value.
STOREFRONT_MIGRATION_PREVIEW_BYPASS_SECRET=
STOREFRONT_API_URL=https://api.tijarago.com
# Internal local backend target. Browser-facing development links preserve the
# hostname currently used by the browser, so this never needs a LAN IP.
DEV_API_URL=https://127.0.0.1:8001
DEMO_API_URL=https://127.0.0.1:8090
STOREFRONT_BASE_DOMAIN=tijarago.com
# Explicit production SEO kill switch. Existing stores still require an
# individual merchant opt-in and a verified live storefront.
STOREFRONT_INDEXING_ENABLED=False
# Keep disabled until the custom-domain browser/auth/checkout canary passes.
STOREFRONT_CUSTOM_DOMAINS_ENABLED=false
# Fixed DNS-over-HTTPS resolver used for public validation; redirects are rejected.
STOREFRONT_DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query
# Official read-only theme demos may only be framed by these HTTPS origins.
THEME_PREVIEW_ALLOWED_ORIGINS=https://www.tijarago.com
THEME_PREVIEW_SIGNUP_URL=https://www.tijarago.com/signup
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Enable Email Routing on mail.tijarago.com in Cloudflare before using these.
# Token: Email Routing Addresses Read/Write and Rules Read/Write.
CLOUDFLARE_EMAIL_ROUTING_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
STORE_EMAIL_DOMAIN=mail.tijarago.com
CLOUDFLARE_EMAIL_WORKER_NAME=tijarago-store-mail
# Use local only for development; it prevents mailbox activation from changing Cloudflare rules.
MAILBOX_TRANSPORT_MODE=cloud
# Shared HMAC secret used only by the Cloudflare Email Worker inbound webhook.
MAILBOX_INBOUND_SECRET=
# Resend webhook signing secret (whsec_...) for delivery-state updates.
RESEND_WEBHOOK_SECRET=
MAILBOX_RETENTION_DAYS=90
STOREFRONT_HEALTHCHECK_TIMEOUT=15
# Behavioural storefront events only; commerce records are never purged by this setting.
ANALYTICS_EVENT_RETENTION_DAYS=395
# One random secret (at least 16 characters) shared only with Vercel Cron.
CRON_SECRET=
VERCEL_API_TIMEOUT=30
VERCEL_API_READ_ATTEMPTS=3

# Platform subscription billing (never use merchant storefront payment keys here)
PLATFORM_PAYMENT_GATEWAY=youcanpay
STOREFRONT_DEFAULT_PAYMENT_GATEWAY=youcanpay
PLATFORM_PAYMENT_PRIVATE_KEY=
PLATFORM_PAYMENT_PUBLIC_KEY=
PLATFORM_PAYMENT_SANDBOX=true
# Optional OAuth token with view-transactions scope. Checkout itself uses the
# private key and redirects to the provider's external payment-form URL.
PLATFORM_PAYMENT_ACCESS_TOKEN=
PLATFORM_PAYMENT_REQUIRE_TRANSACTION_VERIFICATION=false
PLATFORM_PAYMENT_API_TIMEOUT=10
# PayPal Orders adapter for platform SaaS billing. The original variables are
# Sandbox credentials; live mode uses the separate PAYPAL_LIVE_* credentials.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=https://dash.example.test/subscription?payment=success
PAYPAL_CANCEL_URL=https://dash.example.test/subscription?payment=canceled
# At least one receiver identity per environment is required.
PAYPAL_MERCHANT_ID=
PAYPAL_RECEIVER_EMAIL=
PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_WEBHOOK_ID=
PAYPAL_LIVE_MERCHANT_ID=
PAYPAL_LIVE_RECEIVER_EMAIL=
PAYPAL_API_TIMEOUT=10
SUBSCRIPTION_CHECKOUT_INITIALIZATION_TIMEOUT_SECONDS=120
SUBSCRIPTION_CHECKOUT_SESSION_TTL_SECONDS=900
MERCHANT_DASHBOARD_URL=https://dash.tijarago.com
MERCHANT_TERMS_VERSION=2026-08

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Optional local/test override. Keeps generated fixture uploads outside the repository.
# DJANGO_MEDIA_ROOT=/tmp/tijarago-media
# Production media storage (required on read-only/serverless hosts such as Vercel).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional explicit backend override.
# DJANGO_FILE_STORAGE=cloudinary_storage.storage.MediaCloudinaryStorage
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
TEST_MAIL=
EMAIL_VERIFICATION_TIMEOUT_SECONDS=600
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TIMEOUT_SECONDS=1800
EMAIL_VERIFICATION_FRONTEND_URL=https://dash.tijarago.com/verify-email
PLATFORM_NAME=TijaraGO
PLATFORM_TAGLINE=Commerce, made simple
PLATFORM_BRAND_COLOR="#1F8A8C"
PLATFORM_BRAND_ACCENT_COLOR="#20C6C8"
PLATFORM_BRAND_INK_COLOR="#073B3C"
PLATFORM_BRAND_GOLD_COLOR="#D5B36A"
PLATFORM_EMAIL_LOGO_URL=https://www.tijarago.com/brand/logos-4x/tyjara-go-teal-cyan-4x.png
SHOWROOM_EMAIL_BRAND_COLOR="#0E92E4"
SHOWROOM_EMAIL_BRAND_ACCENT_COLOR="#00B4D8"
SHOWROOM_EMAIL_BRAND_INK_COLOR="#073B5C"
SHOWROOM_EMAIL_LOGO_URL=https://www.tijarago.com/brand/logos-4x/tyjara-go-blue-cyan-4x.png
MERCHANT_EMAIL_BRAND_COLOR="#2D6A4F"
MERCHANT_EMAIL_BRAND_ACCENT_COLOR="#52B788"
MERCHANT_EMAIL_BRAND_INK_COLOR="#1B4332"
MERCHANT_EMAIL_LOGO_URL=https://dash.tijarago.com/brand/logos-4x/tyjara-go-green-lime-4x.png
PLATFORM_WEBSITE_URL=https://www.tijarago.com
PLATFORM_SUPPORT_EMAIL=
SHOWROOM_URL=https://www.tijarago.com
# Local-only override when Cloudinary variables are present in your shell.
# DJANGO_FILE_STORAGE=django.core.files.storage.FileSystemStorage
